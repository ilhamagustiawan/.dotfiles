{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "session": {
    "markdown": "rendered",
    "verbosity": "low",
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "experimental": {
    "todo": true
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "terminal": {
    "copy": "select"
  },
}
