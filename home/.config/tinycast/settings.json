      "com.mitchellh.ghostty": {
        "shortcut": "hyper+2",
        "alias": null,
        "showInLauncher": true
      },
      "com.spotify.client": {
        "shortcut": "hyper+3",
        "alias": null,
        "showInLauncher": true
      },
      "md.obsidian": {
        "shortcut": "hyper+5",
        "alias": null,
        "showInLauncher": true
      }
    }
